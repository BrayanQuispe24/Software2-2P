generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  codigo              String     @unique @db.VarChar(50)
  nombre              String     @db.VarChar(100)
  apellido            String     @db.VarChar(100)
  estado              String     @default("ACTIVO") @db.VarChar(20)
  ci                  String     @unique @db.VarChar(20)
  celular             String     @db.VarChar(20)
  email               String     @unique @db.VarChar(255)
  aceptaTerminos      Boolean    @default(false) @map("acepta_terminos")
  fechaAceptaTerminos DateTime?  @map("fecha_acepta_terminos")
  tipoUsuario         String     @default("USUARIO") @map("tipo_usuario") @db.VarChar(50)
  fechaRegistro       DateTime   @default(now()) @map("fecha_registro")
  passwordHash        String     @map("password_hash")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")
  userRoles           UserRole[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  name  String           @unique @db.VarChar(100)
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}
