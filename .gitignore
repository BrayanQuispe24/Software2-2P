# ==========================================
# MASTER .GITIGNORE - ECOSISTEMA DISTRIBUIDO
# ==========================================

# --- Dependencias y Paquetes ---
**/node_modules/
**/vendor/
**/.pnpm-store/

# --- Artefactos de Compilación y Bundles ---
**/dist/
**/build/
**/target/
**/.angular/
**/.tsbuildinfo
*.tsbuildinfo
**/.mvn/wrapper/maven-wrapper.jar

# Proteger código fuente de Arquitectura Hexagonal (Ports & Adapters)
!**/ports/out/**
!**/adapters/out/**
!**/Ports/Out/**
!**/Adapters/Out/**

# --- Variables de Entorno y Secretos ---
**/.env
**/.env.*
!**/.env.example

# --- Certificados y Llaves Criptográficas ---
**/keys/*
!**/keys/.gitkeep
**/*.jwks.json
!**/*.jwks.json.example
**/*.pem
**/*.key
**/*.pfx
**/*.p12

# --- Laravel / PHP Cache y Logs ---
ms-entrenamiento/storage/*.key
ms-inventario/storage/*.key
ms-entrenamiento/storage/framework/cache/*
!ms-entrenamiento/storage/framework/cache/.gitignore
ms-entrenamiento/storage/framework/sessions/*
!ms-entrenamiento/storage/framework/sessions/.gitignore
ms-entrenamiento/storage/framework/views/*
!ms-entrenamiento/storage/framework/views/.gitignore
ms-entrenamiento/storage/logs/*
!ms-entrenamiento/storage/logs/.gitignore
ms-inventario/storage/framework/cache/*
!ms-inventario/storage/framework/cache/.gitignore
ms-inventario/storage/framework/sessions/*
!ms-inventario/storage/framework/sessions/.gitignore
ms-inventario/storage/framework/views/*
!ms-inventario/storage/framework/views/.gitignore
ms-inventario/storage/logs/*
!ms-inventario/storage/logs/.gitignore
**/.phpunit.result.cache

# --- Logs y Procesos ---
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/*.pid
**/*.seed

# --- Pruebas y Cobertura ---
**/coverage/
**/.nyc_output/

# --- Editores e IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Archivos del Sistema Operativo ---
.DS_Store
Thumbs.db
desktop.ini
